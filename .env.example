# Copy to .env (never commit .env). Defaults run the whole stack against the
# mock services; see docs/real-accounts.md to switch to real Okta/Slack/Jira.

# --- Platform secrets: generate your own, e.g. `openssl rand -hex 32` ---
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me-postgres-password
N8N_RUNNERS_AUTH_TOKEN=change-me-runners-token
# HR systems must send this in the X-W0RKFL0W5-Secret header.
WEBHOOK_SECRET=change-me-local-webhook-secret

# Start the mock Okta/Slack/Jira service. Remove when using real accounts.
COMPOSE_PROFILES=mocks
TZ=America/Los_Angeles

# --- Okta ---
OKTA_BASE_URL=http://mocks:8080/okta
OKTA_API_TOKEN=mock-okta-token

# --- Slack ---
SLACK_API_URL=http://mocks:8080/slack/api
SLACK_BOT_TOKEN=xoxb-mock-slack-token
SLACK_ONBOARDING_CHANNEL=#it-onboarding
SLACK_IT_ALERTS_CHANNEL=#it-alerts

# --- Jira ---
JIRA_BASE_URL=http://mocks:8080/jira
# Where people open tickets in a browser (differs from the API URL for the mocks).
JIRA_BROWSE_URL=http://localhost:4010/jira
JIRA_EMAIL=it-bot@example.com
JIRA_API_TOKEN=mock-jira-token
JIRA_PROJECT_KEY=IT
JIRA_ISSUE_TYPE=Task
