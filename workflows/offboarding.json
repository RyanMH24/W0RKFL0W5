    {
      "parameters": {
        "jsCode": "// Snapshot access before anything destructive happens, so the audit trail\n// exists even if a later step fails.\nconst req = $('Validate Request').first().json;\nconst user = $('Check Okta Lookup').first().json;\nconst groups = ($('Okta: List Groups').first().json.body ?? []).map((g) => g.profile.name);\nconst { jira } = $('Parse Config').first().json.data;\nconst description = [\n  'h3. Leaver',\n  `*Name:* ${user.name}`,\n  `*Login:* ${req.login}`,\n  `*Employee ID:* ${req.employeeId}`,\n  `*Requested by:* ${req.requestedBy}`,\n  `*Reason:* ${req.reason}`,\n  '',\n  'h3. Access at time of offboarding',\n  `Okta status: ${user.status}`,\n  ...(groups.length ? groups.map((g) => `* ${g}`) : ['_No group memberships._']),\n  '',\n  'h3. Automated',\n  '(/) Okta sessions and OAuth tokens revoked',\n  '(/) Okta account deactivated (app access removed via provisioning)',\n  '',\n  'h3. Remaining checklist',\n  '* Collect laptop and badge',\n  '* Transfer Google Drive and calendar ownership to the manager',\n  '* Confirm downstream apps deprovisioned (SCIM)',\n  '',\n  `_Created by W0RKFL0W5, execution ${$execution.id}._`,\n].join('\\n');\nreturn [{\n  json: {\n    fields: {\n      project: { key: jira.projectKey },\n      issuetype: { name: jira.issueType },\n      summary: `Offboard ${user.name} (${req.login})`,\n      labels: ['w0rkfl0w5', 'offboarding', req.ticketLabel],\n      description,\n    },\n  },\n}];\n"
      },
