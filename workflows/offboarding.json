    {
      "parameters": {
        "jsCode": "const body = $('Offboarding Request').first().json.body ?? {};\nconst str = (key) => (typeof body[key] === 'string' ? body[key].trim() : '');\nconst errors = [];\nfor (const key of ['employeeId', 'workEmail', 'requestedBy']) {\n  if (!str(key)) errors.push(`${key} is required`);\n}\nconst email = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nfor (const key of ['workEmail', 'requestedBy']) {\n  if (str(key) && !email.test(str(key))) errors.push(`${key} must be an email address`);\n}\nif (str('employeeId') && !/^[A-Za-z0-9-]+$/.test(str('employeeId'))) {\n  errors.push('employeeId may only contain letters, digits, and dashes');\n}\nif (errors.length) return [{ json: { valid: false, errors } }];\nreturn [{\n  json: {\n    valid: true,\n    employeeId: str('employeeId'),\n    login: str('workEmail').toLowerCase(),\n    requestedBy: str('requestedBy').toLowerCase(),\n    reason: str('reason') || 'not specified',\n    ticketLabel: `w0rkfl0w5-offboard-${str('employeeId')}`,\n  },\n}];\n"
      },
