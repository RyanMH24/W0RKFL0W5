      "parameters": {
        "jsCode": "const { req, user, groups, key } = $('Summarize').first().json;\nconst { jira } = $('Parse Config').first().json.data;\nreturn [{\n  json: {\n    status: 'offboarded',\n    employeeId: req.employeeId,\n    okta: { userId: user.userId, status: 'DEPROVISIONED', sessionsRevoked: true, groupsAtOffboarding: groups },\n    jira: { key, url: `${jira.browseUrl}/browse/${key}` },\n    slack: { itAlerted: $input.first().json.ok === true },\n  },\n}];\n"
