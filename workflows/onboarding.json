          "name": "Slack bot token"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const plan = $('Validate & Plan').first().json;\nconst { jira } = $('Parse Config').first().json.data;\nconst user = $('Plan Group Assignments').first().json;\nconst newTicket = $('Jira: Create Ticket').isExecuted ? $('Jira: Create Ticket').first().json : null;\nconst key = newTicket ? newTicket.key : $('Jira: Find Ticket').first().json.issues[0].key;\nconst dm = $('Slack: DM Manager').isExecuted ? $('Slack: DM Manager').first().json : null;\nreturn [{\n  json: {\n    status: newTicket ? 'onboarded' : 'already_onboarded',\n    employeeId: plan.employeeId,\n    okta: { userId: user.userId, created: user.created, groups: plan.groups },\n    jira: { key, url: `${jira.browseUrl}/browse/${key}` },\n    slack: { announced: Boolean(newTicket), managerNotified: dm?.ok === true },\n  },\n}];\n"
      },
      "id": "3990f5b5-7a49-43f9-a227-b433d50b3751",
      "name": "Build Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4840,
        280
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
