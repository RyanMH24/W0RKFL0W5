    {
      "parameters": {
        "jsCode": "// Validates the HR request and resolves the access plan from the policy.\nconst body = $('Onboarding Request').first().json.body ?? {};\nconst { policy } = $('Parse Config').first().json.data;\nconst str = (key) => (typeof body[key] === 'string' ? body[key].trim() : '');\nconst errors = [];\n\nfor (const key of ['employeeId', 'firstName', 'lastName', 'workEmail', 'department', 'title', 'managerEmail', 'startDate']) {\n  if (!str(key)) errors.push(`${key} is required`);\n}\nconst email = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nfor (const key of ['workEmail', 'managerEmail']) {\n  if (str(key) && !email.test(str(key))) errors.push(`${key} must be an email address`);\n}\nif (str('employeeId') && !/^[A-Za-z0-9-]+$/.test(str('employeeId'))) {\n  errors.push('employeeId may only contain letters, digits, and dashes');\n}\nif (str('startDate') && !/^\\d{4}-\\d{2}-\\d{2}$/.test(str('startDate'))) errors.push('startDate must be YYYY-MM-DD');\nconst department = policy.departments[str('department')];\nif (str('department') && !department) {\n  errors.push(`department must be one of: ${Object.keys(policy.departments).join(', ')}`);\n}\nif (errors.length) return [{ json: { valid: false, errors } }];\n\nreturn [{\n  json: {\n    valid: true,\n    employeeId: str('employeeId'),\n    firstName: str('firstName'),\n    lastName: str('lastName'),\n    login: str('workEmail').toLowerCase(),\n    department: str('department'),\n    title: str('title'),\n    managerEmail: str('managerEmail').toLowerCase(),\n    startDate: str('startDate'),\n    groups: [...new Set([...policy.baseline.oktaGroups, ...department.oktaGroups])],\n    ticketLabel: `w0rkfl0w5-onboard-${str('employeeId')}`,\n  },\n}];\n"
      },
