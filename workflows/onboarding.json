    {
      "parameters": {
        "jsCode": "const plan = $('Validate & Plan').first().json;\nconst { jira } = $('Parse Config').first().json.data;\nconst created = $('Plan Group Assignments').first().json.created;\nconst description = [\n  'h3. New hire',\n  `*Name:* ${plan.firstName} ${plan.lastName}`,\n  `*Title / department:* ${plan.title}, ${plan.department}`,\n  `*Start date:* ${plan.startDate}`,\n  `*Manager:* ${plan.managerEmail}`,\n  `*Employee ID:* ${plan.employeeId}`,\n  '',\n  'h3. Automated',\n  created ? `(/) Okta account ${plan.login} created (STAGED until start date)` : `(/) Okta account ${plan.login} already existed; access re-applied`,\n  `(/) Okta groups: ${plan.groups.join(', ')}`,\n  '',\n  'h3. Remaining checklist',\n  '* Ship and enroll laptop (Jamf / Intune)',\n  '* Activate Okta account on the start date',\n  '* Manager confirms Day 1 access',\n  '',\n  `_Created by W0RKFL0W5, execution ${$execution.id}._`,\n].join('\\n');\nreturn [{\n  json: {\n    fields: {\n      project: { key: jira.projectKey },\n      issuetype: { name: jira.issueType },\n      summary: `Onboard ${plan.firstName} ${plan.lastName} (${plan.title}, ${plan.department}), starts ${plan.startDate}`,\n      labels: ['w0rkfl0w5', 'onboarding', plan.ticketLabel],\n      description,\n    },\n  },\n}];\n"
      },
