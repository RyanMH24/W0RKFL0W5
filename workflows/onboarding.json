        "jsonBody": "={{ JSON.stringify({\n      channel: $('Parse Config').first().json.data.slack.onboardingChannel,\n      text: ':wave: New hire: *' + $('Validate & Plan').first().json.firstName + ' ' + $('Validate & Plan').first().json.lastName + '* (' + $('Validate & Plan').first().json.title + ', ' + $('Validate & Plan').first().json.department + ') starts ' + $('Validate & Plan').first().json.startDate + '. Okta account staged with ' + $('Validate & Plan').first().json.groups.length + ' groups. Setup ticket: <' + $('Parse Config').first().json.data.jira.browseUrl + '/browse/' + $('Jira: Create Ticket').first().json.key + '|' + $('Jira: Create Ticket').first().json.key + '>',\n      unfurl_links: false,\n    }) }}",
