    {
      "parameters": {
        "jsCode": "// Slack reports failures as HTTP 200 with ok: false, so check explicitly.\nconst res = $input.first().json;\nif (!res.ok) throw new Error(`Slack announce failed: ${res.error}`);\nconst manager = $('Slack: Find Manager').first().json;\nreturn [{ json: { managerSlackId: manager.ok ? manager.user.id : null } }];\n"
      },
