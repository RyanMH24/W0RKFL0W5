        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n      channel: $json.managerSlackId,\n      text: 'Hi! Your new hire *' + $('Validate & Plan').first().json.firstName + ' ' + $('Validate & Plan').first().json.lastName + '* starts ' + $('Validate & Plan').first().json.startDate + '. IT is tracking setup in ' + $('Jira: Create Ticket').first().json.key + '. Reply in #it-help if anything is missing on Day 1.',\n    }) }}",
        "options": {}
