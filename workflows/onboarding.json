    {
      "parameters": {
        "jsCode": "// Okta's q= is a prefix search, so require an exact name match.\nconst plans = $('Plan Group Assignments').all();\nreturn $input.all().map((item, i) => {\n  const { groupName, userId } = plans[i].json;\n  const group = (item.json.body ?? []).find((g) => g.profile.name === groupName);\n  if (!group) {\n    throw new Error(`Okta group \"${groupName}\" not found. Create it in Okta or fix config/access-policy.json.`);\n  }\n  return { json: { groupId: group.id, groupName, userId } };\n});\n"
      },
