      "parameters": {
        "jsCode": "// 404 means a new hire; anything other than 200/404 is a real failure.\nconst res = $input.first().json;\nif (res.statusCode === 404) return [{ json: { exists: false } }];\nif (res.statusCode === 200) return [{ json: { exists: true, userId: res.body.id, status: res.body.status } }];\nthrow new Error(`Okta user lookup failed: HTTP ${res.statusCode} ${JSON.stringify(res.body)}`);\n"
      },
