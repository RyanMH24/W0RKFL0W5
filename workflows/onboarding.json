    {
      "parameters": {
        "jsCode": "// One item per group, whether the user was just created or already existed.\nconst created = $('Okta: Create User').isExecuted;\nconst userId = created ? $('Okta: Create User').first().json.id : $('Check Okta Lookup').first().json.userId;\nreturn $('Validate & Plan').first().json.groups.map((groupName) => ({ json: { groupName, userId, created } }));\n"
      },
